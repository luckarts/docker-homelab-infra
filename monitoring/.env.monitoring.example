# =============================================================================
# .env.monitoring.example — Variables d'environnement pour la stack monitoring
# =============================================================================
# Copier vers .env.monitoring (a cote de ce fichier) et adapter.
# Le fichier .env.monitoring est charge par deploy.sh monitoring (--env-file).
# =============================================================================

# ── Grafana ─────────────────────────────────────────────────────────────
# Mot de passe admin Grafana (change en prod obligatoirement)
GRAFANA_ADMIN_PASSWORD=changeme

# ── Domaine ─────────────────────────────────────────────────────────────
# Domaine Grafana (pour le reverse proxy Traefik)
GRAFANA_DOMAIN=monitoring.bachelart.fr

# ── Alertmanager ────────────────────────────────────────────────────────
# Credentials Brevo SMTP pour les notifications email
ALERTMANAGER_SMTP_USERNAME=ton-email@example.com
ALERTMANAGER_SMTP_PASSWORD=ton-mot-de-passe-smtp

# ── CrowdSec ────────────────────────────────────────────────────────────
# UID/GID pour les permissions des fichiers CrowdSec
PUID=1000
PGID=1000