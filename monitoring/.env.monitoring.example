# =============================================================================
# .env.monitoring.example — Variables d'environnement pour la stack monitoring
# =============================================================================
# Copier vers .env.monitoring (à côté de ce fichier) et adapter.
# Le fichier .env.monitoring est chargé par deploy.sh monitoring (--env-file).
# =============================================================================

# ── Grafana ─────────────────────────────────────────────────────────────
# Mot de passe admin Grafana (changé en prod obligatoirement)
GRAFANA_ADMIN_PASSWORD=changeme

# ── Domaine ─────────────────────────────────────────────────────────────
# Domaine Grafana (pour le reverse proxy Traefik)
GRAFANA_DOMAIN=monitoring.bachelart.fr